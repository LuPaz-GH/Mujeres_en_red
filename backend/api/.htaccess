# Todos los pedidos a /api/... los atiende index.php
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^lib/ - [F,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L]
</IfModule>

# config.php tiene la contraseña de la base de datos: nunca se muestra
<Files "config*.php">
  Require all denied
</Files>
